# Base URL of the system under test
BASE_URL=https://automationintesting.online

# Admin credentials. These are the public demo credentials shipped with the
# restful-booker-platform project; they are externalised so the specs never
# carry a credential literal and so the suite can be pointed at a private
# deployment without editing code.
ADMIN_USER=admin
ADMIN_PASS=password

# Number of Playwright workers. See STRATEGY.md for the measurement behind the
# default of 3.
WORKERS=4
